---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <header class="wrap grid p-head">
    <h1>That page is not here.</h1>
    <p class="stand">It may have belonged to an earlier version of this site.</p>
  </header>
  <div class="wrap grid sec">
    <div class="prose">
      <p><a href="/">Home</a>, <a href="/projects/">Projects</a>, or <a href="/about/">About</a>.</p>
    </div>
  </div>
</Base>
